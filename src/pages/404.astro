---
import Base from '../layouts/Base.astro';
---

<Base title="404 — Aness Bouziani" description="Page not found.">
  <main class="wrap">
    <div class="term">
      <div class="term-bar">
        <span class="dot dot-r"></span>
        <span class="dot dot-y"></span>
        <span class="dot dot-g"></span>
        <span class="term-title">visitor@aness — zsh</span>
      </div>
      <div class="term-body">
        <div class="row">
          <span class="p-user">visitor@aness</span><span class="p-sep">:</span><span class="p-path">~</span><span class="p-sep">$</span>&nbsp;<span class="echo" id="cmd"></span>
        </div>
        <div class="row err">zsh: no such page: <span id="path-echo">this one</span> <span class="code">(404)</span></div>
        <div class="row hint">
          <span class="dim">hint:</span> try one of these instead —
        </div>
        <div class="row links">
          <a href="/">cd ~</a>
          <a href="/work">cat projects</a>
          <a href="/stack">open stack</a>
          <a href="/contact">ping aness</a>
        </div>
        <div class="row cursor-row">
          <span class="p-user">visitor@aness</span><span class="p-sep">:</span><span class="p-path">~</span><span class="p-sep">$</span>&nbsp;<span class="cursor">&nbsp;</span>
        </div>
      </div>
    </div>
  </main>
</Base>

<script>
  // echo the actual missing path into the fake command
  const p = window.location.pathname;
  document.getElementById('cmd')!.textContent = `open ${p}`;
  document.getElementById('path-echo')!.textContent = p;
</script>

<style>
  .wrap {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
  }
  .term {
    width: min(560px, 100%);
    background: #16181d;
    border-radius: 14px;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.25), 0 2px 10px rgba(0, 0, 0, 0.12);
    overflow: hidden;
  }
  .term-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 14px;
    background: #23262d;
    position: relative;
  }
  .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }
  .dot-r { background: #ff5f57; }
  .dot-y { background: #febc2e; }
  .dot-g { background: #28c840; }
  .term-title {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    font-family: ui-monospace, 'SF Mono', Menlo, Monaco, monospace;
    font-size: 12.5px;
    color: #8a8f98;
  }
  .term-body {
    padding: 20px 22px 26px;
    font-family: ui-monospace, 'SF Mono', Menlo, Monaco, monospace;
    font-size: 14px;
    line-height: 1.9;
    color: #d7dae0;
  }
  .row { white-space: pre-wrap; word-break: break-word; }
  .err { color: #ff7b72; }
  .hint, .dim { color: #8a8f98; }
  .code { color: #ffd58a; }
  .p-user { color: #7ee787; }
  .p-path { color: #6fbbff; }
  .p-sep { color: #8a8f98; }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    padding: 4px 0 8px;
  }
  .links a {
    color: #ffd58a;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(255, 213, 138, 0.4);
  }
  .links a:hover {
    color: #ffe4ae;
    text-decoration-color: currentColor;
  }
  .cursor {
    display: inline-block;
    min-width: 8.4px;
    background: #d7dae0;
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% { background: transparent; }
  }
</style>
