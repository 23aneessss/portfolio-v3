---
import Base from '../layouts/Base.astro';

const LINKS = {
  gmail: 'mailto:oa_bouziani@esi.dz',
  github: 'https://github.com/23aneessss',
  linkedin: 'https://www.linkedin.com/in/YOUR_HANDLE', // EDIT — you didn't share this one
  instagram: 'https://www.instagram.com/23aneesssss?igsh=MWlsdG9vamV0a2Nwbg%3D%3D&utm_source=qr',
  facebook: 'https://www.facebook.com/share/1HvSEUu7Vx/?mibextid=wwXIfr',
  whatsapp: 'https://wa.me/213782594339',
  phone: 'tel:+213782594339',
  discord: 'anesbouziani', // username only — copied to clipboard (no public profile URL by username)
};

interface App {
  name: string;
  icon?: string; // official app icon in /public/icons
  svg?: 'discord'; // inline SVG logo (no image file in /public/icons)
  live?: 'calendar' | 'clock'; // rendered live (real date / ticking clock), like iOS does
  href?: string; // clickable → real contact link
  copy?: string; // clickable → copies this text to clipboard (no public URL available)
  msg?: string; // decorative → funny banner message
}

// icons are the official App Store artwork, downloaded to /public/icons
const GRID: App[] = [
  { name: 'Calendar', live: 'calendar', msg: 'my calendar is wide open — book me 😌' },
  { name: 'Clock', live: 'clock', msg: "it's always a good time to say hi ⏰" },
  { name: 'Photos', icon: '/icons/photos.jpg', msg: 'mostly screenshots of terminal output 🖼️' },
  { name: 'Camera', icon: '/icons/camera.jpg', msg: 'say cheese… nope, nothing here 📸' },
  { name: 'Instagram', icon: '/icons/instagram.jpg', href: LINKS.instagram },
  { name: 'Facebook', icon: '/icons/facebook.jpg', href: LINKS.facebook },
  { name: 'WhatsApp', icon: '/icons/whatsapp.jpg', href: LINKS.whatsapp },
  { name: 'Safari', icon: '/icons/safari.jpg', msg: "you're already on the best website 😎" },
  { name: 'Notes', icon: '/icons/notes.jpg', msg: 'TODO: reply to Aness ✏️' },
  { name: 'Calculator', icon: '/icons/calculator.jpg', msg: 'you + me = 🤝 (the math checks out)' },
  { name: 'Maps', icon: '/icons/maps.jpg', msg: '📍 Algiers, Algeria — remote-friendly' },
  { name: 'Discord', svg: 'discord', copy: LINKS.discord },
];

const DOCK: App[] = [
  { name: 'Phone', icon: '/icons/phone.jpg', href: LINKS.phone },
  { name: 'Gmail', icon: '/icons/gmail.jpg', href: LINKS.gmail },
  { name: 'GitHub', icon: '/icons/github.jpg', href: LINKS.github },
  { name: 'LinkedIn', icon: '/icons/linkedin.jpg', href: LINKS.linkedin },
];

const external = (href?: string) =>
  !!href && !href.startsWith('mailto:') && !href.startsWith('tel:');
---

<Base title="Contact — Aness Bouziani" description="Get in touch with Aness Bouziani — pick an app.">
  <header class="header">
    <a class="back" href="/">←</a>
    <div>
      <h1 class="title">Contact</h1>
      <p class="hint">It's a real phone. The apps actually work — tap one. (Long-press for a surprise.)</p>
    </div>
  </header>

  <main class="stage" id="stage">
    <div class="iphone" id="iphone">
      <span class="side-btn side-action"></span>
      <span class="side-btn side-vol1"></span>
      <span class="side-btn side-vol2"></span>
      <span class="side-btn side-power"></span>

      <div class="screen" id="screen">
        <div class="island"></div>

        <div class="statusbar">
          <span class="sb-time" id="sb-time">9:41</span>
          <span class="sb-right">
            <svg class="sb-signal" viewBox="0 0 18 12" fill="currentColor"><rect x="0" y="7.5" width="3" height="4.5" rx="1"/><rect x="5" y="5" width="3" height="7" rx="1"/><rect x="10" y="2.5" width="3" height="9.5" rx="1"/><rect x="15" y="0" width="3" height="12" rx="1"/></svg>
            <svg class="sb-wifi" viewBox="0 0 16 12" fill="currentColor"><path d="M8 9.6a1.7 1.7 0 0 1 1.7 1.7L8 12l-1.7-.7A1.7 1.7 0 0 1 8 9.6zM8 5.5c1.7 0 3.2.6 4.4 1.7l-1.4 1.5A4.4 4.4 0 0 0 8 7.6c-1.1 0-2.2.4-3 1.1L3.6 7.2A6.5 6.5 0 0 1 8 5.5zM8 1.4c2.8 0 5.4 1.1 7.3 2.9L13.9 5.7A8.5 8.5 0 0 0 8 3.5c-2.3 0-4.4.9-5.9 2.2L.7 4.3A10.6 10.6 0 0 1 8 1.4z"/></svg>
            <span class="sb-batt"><i></i></span>
          </span>
        </div>

        <button class="widget" id="widget" title="Say hi by email">
          <img class="w-avatar" src="/avatar.webp" alt="Aness Bouziani" />
          <span class="w-text">
            <span class="w-name">Aness Bouziani</span>
            <span class="w-sub">open to work — say hi 👋</span>
          </span>
          <span class="w-dot"></span>
        </button>

        <div class="grid" id="grid">
          {
            GRID.map((app) => {
              const tile =
                app.live === 'calendar' ? (
                  <span class="tile tile-cal">
                    <span class="cal-dow" id="cal-dow">MON</span>
                    <span class="cal-day" id="cal-day">1</span>
                  </span>
                ) : app.live === 'clock' ? (
                  <span class="tile tile-clock">
                    <span class="clockface">
                      <i class="hand h-hour" id="h-hour"></i>
                      <i class="hand h-min" id="h-min"></i>
                      <i class="hand h-sec" id="h-sec"></i>
                      <i class="pin"></i>
                    </span>
                  </span>
                ) : app.svg === 'discord' ? (
                  <span class="tile tile-discord">
                    <svg viewBox="0 0 127.14 96.36" fill="currentColor" aria-hidden="true">
                      <path d="M107.7 8.07A105.15 105.15 0 0 0 80.92 0a72.7 72.7 0 0 0-3.36 6.89 97.2 97.2 0 0 0-29.06 0A72.7 72.7 0 0 0 45.14 0 105.1 105.1 0 0 0 18.37 8.07C2.79 32.65-1.71 56.6.54 80.21a105.9 105.9 0 0 0 32.17 16.15 77.45 77.45 0 0 0 6.89-11.11 68.3 68.3 0 0 1-10.85-5.18c.91-.66 1.8-1.34 2.66-2.05a75.57 75.57 0 0 0 64.32 0c.86.71 1.75 1.39 2.66 2.05a68.3 68.3 0 0 1-10.86 5.18 77.45 77.45 0 0 0 6.89 11.11 105.9 105.9 0 0 0 32.19-16.15c2.62-27.45-4.48-51.17-18.69-76.14zM42.45 65.69C36.18 65.69 31 59.94 31 52.94s5-12.75 11.4-12.75 11.5 5.85 11.39 12.75c0 7-5 12.75-11.34 12.75zm42.24 0c-6.27 0-11.39-5.75-11.39-12.75s5-12.75 11.39-12.75S96 45.94 96 52.94s-5 12.75-11.31 12.75z"/>
                    </svg>
                  </span>
                ) : (
                  <span class="tile"><img src={app.icon} alt="" loading="lazy" /></span>
                );
              return app.href ? (
                <a
                  class="app"
                  href={app.href}
                  target={external(app.href) ? '_blank' : undefined}
                  rel={external(app.href) ? 'noopener' : undefined}
                >
                  {tile}
                  <span class="badge">✕</span>
                  <span class="app-label">{app.name}</span>
                </a>
              ) : app.copy ? (
                <button class="app app-copy" data-copy={app.copy} title={`Copy ${app.name} username`}>
                  {tile}
                  <span class="badge">✕</span>
                  <span class="app-label">{app.name}</span>
                </button>
              ) : (
                <button class="app app-deco" data-msg={app.msg}>
                  {tile}
                  <span class="badge">✕</span>
                  <span class="app-label">{app.name}</span>
                </button>
              );
            })
          }
        </div>

        <div class="dots"><i class="on"></i><i></i></div>

        <div class="dock">
          {
            DOCK.map((app) => (
              <a
                class="app app-dock"
                href={app.href}
                target={external(app.href) ? '_blank' : undefined}
                rel={external(app.href) ? 'noopener' : undefined}
                title={app.name}
                aria-label={app.name}
              >
                <span class="tile"><img src={app.icon} alt={app.name} loading="lazy" /></span>
                <span class="badge">✕</span>
              </a>
            ))
          }
        </div>

        <div class="homebar"></div>

        <div class="banner" id="banner"></div>
        <button class="done-pill" id="done-pill">Done</button>
      </div>
    </div>
  </main>
</Base>

<script>
  const screen = document.getElementById('screen')!;
  const iphone = document.getElementById('iphone')!;
  const stage = document.getElementById('stage')!;
  const banner = document.getElementById('banner')!;
  const donePill = document.getElementById('done-pill')!;
  const widget = document.getElementById('widget')!;

  // ---------- live status bar / calendar / clock ----------
  const sbTime = document.getElementById('sb-time')!;
  const calDow = document.getElementById('cal-dow')!;
  const calDay = document.getElementById('cal-day')!;
  const hHour = document.getElementById('h-hour')!;
  const hMin = document.getElementById('h-min')!;
  const hSec = document.getElementById('h-sec')!;
  const DOW = ['SUNDAY', 'MONDAY', 'TUESDAY', 'WEDNESDAY', 'THURSDAY', 'FRIDAY', 'SATURDAY'];

  const tick = () => {
    const d = new Date();
    sbTime.textContent = `${d.getHours()}:${String(d.getMinutes()).padStart(2, '0')}`;
    calDow.textContent = DOW[d.getDay()];
    calDay.textContent = String(d.getDate());
    const s = d.getSeconds();
    const m = d.getMinutes() + s / 60;
    const h = (d.getHours() % 12) + m / 60;
    hHour.style.transform = `translateX(-50%) rotate(${h * 30}deg)`;
    hMin.style.transform = `translateX(-50%) rotate(${m * 6}deg)`;
    hSec.style.transform = `translateX(-50%) rotate(${s * 6}deg)`;
  };
  tick();
  setInterval(tick, 1000);

  // ---------- banner ----------
  let bannerTimer = 0;
  const toast = (msg: string) => {
    banner.textContent = msg;
    banner.classList.add('show');
    clearTimeout(bannerTimer);
    bannerTimer = window.setTimeout(() => banner.classList.remove('show'), 2600);
  };

  // ---------- decorative apps talk back ----------
  for (const el of document.querySelectorAll<HTMLElement>('.app-deco')) {
    el.addEventListener('click', () => {
      if (screen.classList.contains('jiggle')) return;
      el.classList.remove('bounce');
      void el.offsetWidth; // restart the animation
      el.classList.add('bounce');
      toast(el.dataset.msg!);
    });
  }

  // ---------- copy-to-clipboard apps (Discord, etc.) ----------
  for (const el of document.querySelectorAll<HTMLElement>('.app-copy')) {
    el.addEventListener('click', async () => {
      if (screen.classList.contains('jiggle')) return;
      const value = el.dataset.copy!;
      let copied = false;
      try {
        await navigator.clipboard.writeText(value);
        copied = true;
      } catch {
        copied = false;
      }
      el.classList.remove('bounce');
      void el.offsetWidth;
      el.classList.add('bounce');
      toast(copied ? `copied “${value}” — ping me on Discord 🎮` : `Discord: ${value}`);
    });
  }
  widget.addEventListener('click', () => {
    if (!screen.classList.contains('jiggle')) window.location.href = 'mailto:oa_bouziani@esi.dz';
  });

  // ---------- jiggle mode (long-press, like the real thing) ----------
  let pressTimer = 0;
  let pressStart: { x: number; y: number } | null = null;

  const enterJiggle = () => {
    if (!screen.classList.contains('jiggle')) {
      screen.classList.add('jiggle');
      toast('jiggle mode — rearrange my life, or press Done');
    }
  };
  const exitJiggle = () => screen.classList.remove('jiggle');

  screen.addEventListener('pointerdown', (e) => {
    if ((e.target as HTMLElement).closest('.done-pill')) return;
    pressStart = { x: e.clientX, y: e.clientY };
    clearTimeout(pressTimer);
    pressTimer = window.setTimeout(enterJiggle, 550);
  });
  const cancelPress = () => {
    clearTimeout(pressTimer);
    pressStart = null;
  };
  screen.addEventListener('pointerup', cancelPress);
  screen.addEventListener('pointerleave', cancelPress);
  screen.addEventListener('pointermove', (e) => {
    if (pressStart && Math.hypot(e.clientX - pressStart.x, e.clientY - pressStart.y) > 12) cancelPress();
  });

  donePill.addEventListener('click', exitJiggle);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') exitJiggle();
  });
  // long-press should trigger jiggle mode, not the native context menu
  screen.addEventListener('contextmenu', (e) => e.preventDefault());

  // while jiggling: block navigation, allow "deleting"
  screen.addEventListener(
    'click',
    (e) => {
      if (!screen.classList.contains('jiggle')) return;
      if ((e.target as HTMLElement).closest('.done-pill')) return; // let Done work
      const badge = (e.target as HTMLElement).closest('.badge');
      const app = (e.target as HTMLElement).closest<HTMLElement>('.app');
      e.preventDefault();
      e.stopPropagation();
      if (!badge || !app) return;
      if (app.classList.contains('app-deco')) {
        app.classList.add('poof');
        setTimeout(() => app.remove(), 220);
      } else {
        iphone.classList.remove('shake');
        void iphone.offsetWidth;
        iphone.classList.add('shake');
        toast("nice try — you'll need that one to reach me 😉");
      }
    },
    true
  );

  // ---------- subtle 3D tilt toward the cursor ----------
  const fine = window.matchMedia('(pointer: fine)').matches;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (fine && !reduced) {
    stage.addEventListener('mousemove', (e) => {
      const r = stage.getBoundingClientRect();
      const x = (e.clientX - r.left) / r.width - 0.5;
      const y = (e.clientY - r.top) / r.height - 0.5;
      iphone.style.transform = `rotateY(${x * 7}deg) rotateX(${-y * 5}deg)`;
    });
    stage.addEventListener('mouseleave', () => {
      iphone.style.transform = '';
    });
  }
</script>

<style>
  .header {
    display: flex;
    align-items: baseline;
    gap: 20px;
    padding: 34px 44px 0;
  }
  .back {
    font-size: 26px;
    font-weight: 700;
    color: #141414;
    text-decoration: none;
    line-height: 1;
  }
  .back:hover {
    color: #6fbbff;
  }
  .title {
    margin: 0;
    font-size: clamp(1.8rem, 3.4vw, 2.6rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }
  .hint {
    margin: 6px 0 0;
    font-size: 15px;
    color: #767676;
  }

  .stage {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px 16px 36px;
    perspective: 1400px;
  }

  /* ---------- the phone ----------
     everything inside is sized in cqw (1% of the phone's width),
     so the whole device scales as one piece, like a render */
  .iphone {
    --r: 16.4cqw; /* outer corner radius */
    position: relative;
    container-type: inline-size;
    width: clamp(290px, 41vh, 385px);
    aspect-ratio: 9 / 19.2;
    /* clean black frame — NOTE: cqw only works on descendants, so the
       frame itself uses % / px (percent radius: x is %width, y is %height) */
    background: #050506;
    border-radius: 17.5% / 8.2%;
    padding: 4px;
    /* no box-shadow: blurred shadows on a 3D-tilted layer can paint as an
       opaque black blob behind the phone in Safari — keep it clean */
    transition: transform 0.25s ease;
    animation: arrive 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  @keyframes arrive {
    from {
      opacity: 0;
      translate: 0 34px;
    }
  }
  .iphone.shake {
    animation: phone-shake 0.45s ease;
  }
  @keyframes phone-shake {
    20% { translate: -7px 0; }
    40% { translate: 6px 0; }
    60% { translate: -4px 0; }
    80% { translate: 3px 0; }
  }
  .side-btn {
    position: absolute;
    background: #1c1d20;
    border-radius: 2px;
  }
  .side-action { left: -3px; top: 17.5%; width: 3px; height: 3.6%; }
  .side-vol1 { left: -3px; top: 24.5%; width: 3px; height: 5.6%; }
  .side-vol2 { left: -3px; top: 31.5%; width: 3px; height: 5.6%; }
  .side-power { right: -3px; top: 27%; width: 3px; height: 8.6%; }

  .screen {
    position: relative;
    width: 100%;
    height: 100%;
    /* black bezel between titanium and the display */
    border: 2.6cqw solid #010102;
    border-radius: calc(var(--r) - 1.1cqw);
    overflow: hidden;
    background:
      radial-gradient(120% 90% at 85% -10%, rgba(255, 255, 255, 0.55), transparent 60%),
      linear-gradient(160deg, #a8c6ff 0%, #c8b9ff 34%, #ffd3e6 68%, #ffe8c6 100%);
    display: flex;
    flex-direction: column;
    user-select: none;
    /* long-press = jiggle mode, not the iOS text/link callout */
    -webkit-user-select: none;
    -webkit-touch-callout: none;
  }

  /* ---------- Dynamic Island + status bar (shared band, iOS proportions) ---------- */
  .island {
    position: absolute;
    top: 2.6cqw;
    left: 50%;
    transform: translateX(-50%);
    width: 30.5cqw;
    height: 8.6cqw;
    background: #000;
    border-radius: 999px;
    z-index: 6;
  }
  .island::after {
    /* camera lens glint */
    content: '';
    position: absolute;
    right: 2.4cqw;
    top: 50%;
    transform: translateY(-50%);
    width: 3.4cqw;
    height: 3.4cqw;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #1e2f4d 0 28%, #0a0d14 60%);
  }
  .statusbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 2.6cqw;
    height: 8.6cqw;
    padding: 0 8.4cqw 0 9.4cqw;
    color: #1c1c1e;
  }
  .sb-time {
    font-size: 4.5cqw;
    font-weight: 650;
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
  }
  .sb-right {
    display: flex;
    align-items: center;
    gap: 1.7cqw;
  }
  .sb-signal { width: 5.2cqw; height: 3.4cqw; }
  .sb-wifi { width: 4.7cqw; height: 3.5cqw; }
  .sb-batt {
    width: 7.4cqw;
    height: 3.7cqw;
    border: 0.4cqw solid rgba(28, 28, 30, 0.4);
    border-radius: 1.2cqw;
    padding: 0.5cqw;
    display: block;
    position: relative;
  }
  .sb-batt::after {
    content: '';
    position: absolute;
    right: -1.3cqw;
    top: 50%;
    transform: translateY(-50%);
    width: 0.7cqw;
    height: 1.5cqw;
    background: rgba(28, 28, 30, 0.4);
    border-radius: 0 1cqw 1cqw 0;
  }
  .sb-batt i {
    display: block;
    height: 100%;
    width: 82%;
    background: #1c1c1e;
    border-radius: 0.5cqw;
  }

  /* ---------- widget ---------- */
  .widget {
    display: flex;
    align-items: center;
    gap: 3.4cqw;
    margin: 5.6cqw 6cqw 1cqw;
    padding: 3.4cqw 4cqw;
    border: none;
    border-radius: 6.4cqw;
    background: rgba(255, 255, 255, 0.42);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    box-shadow: 0 8px 24px rgba(60, 70, 120, 0.14);
    cursor: pointer;
    text-align: left;
    font: inherit;
    transition: transform 0.18s ease;
  }
  .widget:hover { transform: scale(1.02); }
  .widget:active { transform: scale(0.98); }
  .w-avatar {
    width: 12cqw;
    height: 12cqw;
    border-radius: 50%;
    object-fit: cover;
    object-position: top;
    background: #fff;
  }
  .w-text {
    display: flex;
    flex-direction: column;
    gap: 0.6cqw;
    min-width: 0;
  }
  .w-name {
    font-size: 4cqw;
    font-weight: 700;
    color: #16181d;
    letter-spacing: -0.01em;
  }
  .w-sub {
    font-size: 3.3cqw;
    color: #4c5566;
  }
  .w-dot {
    width: 2.6cqw;
    height: 2.6cqw;
    border-radius: 50%;
    background: #34c759;
    margin-left: auto;
    box-shadow: 0 0 0 0.9cqw rgba(52, 199, 89, 0.25);
    animation: pulse 2.2s ease infinite;
  }
  @keyframes pulse {
    50% { box-shadow: 0 0 0 1.8cqw rgba(52, 199, 89, 0.08); }
  }

  /* ---------- app grid ---------- */
  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 3.2cqw 0;
    padding: 3.6cqw 4.6cqw 0;
    flex: 1;
    align-content: start;
    justify-items: center;
  }
  .app {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.6cqw;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    text-decoration: none;
    font: inherit;
    -webkit-tap-highlight-color: transparent;
    animation: pop-in 0.45s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  @keyframes pop-in {
    from {
      opacity: 0;
      scale: 0.6;
    }
  }
  .grid .app:nth-child(1) { animation-delay: 0.05s; }
  .grid .app:nth-child(2) { animation-delay: 0.09s; }
  .grid .app:nth-child(3) { animation-delay: 0.13s; }
  .grid .app:nth-child(4) { animation-delay: 0.17s; }
  .grid .app:nth-child(5) { animation-delay: 0.21s; }
  .grid .app:nth-child(6) { animation-delay: 0.25s; }
  .grid .app:nth-child(7) { animation-delay: 0.29s; }
  .grid .app:nth-child(8) { animation-delay: 0.33s; }
  .grid .app:nth-child(9) { animation-delay: 0.37s; }
  .grid .app:nth-child(10) { animation-delay: 0.41s; }
  .grid .app:nth-child(11) { animation-delay: 0.45s; }
  .grid .app:nth-child(12) { animation-delay: 0.49s; }

  /* one size for every icon on the phone — grid AND dock */
  .tile {
    width: 16.2cqw;
    height: 16.2cqw;
