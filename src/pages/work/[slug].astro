---
import Base from '../../layouts/Base.astro';
import { PROJECTS, STATUS_LABEL } from '../../data/projects';

export function getStaticPaths() {
  return PROJECTS.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}

const { p } = Astro.props;
const idx = PROJECTS.findIndex((x) => x.slug === p.slug);
const next = PROJECTS[(idx + 1) % PROJECTS.length];
---

<Base title={`${p.name} — Aness Bouziani`} description={p.tagline}>
  <main class="page">
    <a class="back" href="/work">← back to the terminal</a>

    <article class="window">
      <div class="titlebar">
        <span class="dot r"></span><span class="dot y"></span><span class="dot g"></span>
        <span class="path">~/projects/{p.slug}</span>
      </div>

      <div class="body">
        <header class="head">
          <div>
            <h1>{p.name}</h1>
            <p class="tagline">{p.tagline}</p>
          </div>
          <span class={`status status--${p.status}`}>{STATUS_LABEL[p.status]}</span>
        </header>

        <p class="summary">{p.summary}</p>

        <div class="actions">
          {p.site && <a class="btn btn--primary" href={p.site} target="_blank" rel="noopener">Visit the site →</a>}
          {p.download && <a class={`btn ${p.site ? '' : 'btn--primary'}`} href={p.download} target="_blank" rel="noopener">↓ Download</a>}
          <a class={`btn ${!p.site && !p.download ? 'btn--primary' : ''}`} href={p.repo} target="_blank" rel="noopener">↗ Source code</a>
        </div>

        {p.shots.length > 0 && (
          <div class="shots">
            {p.shots.map((s, i) => (
              <img class={i === 0 ? 'shot shot--lead' : 'shot'} src={s} alt={`${p.name} screenshot ${i + 1}`} loading="lazy" />
            ))}
          </div>
        )}

        <div class="meta">
          <section>
            <h2>What I built</h2>
            <ul>{p.built.map((b) => <li>{b}</li>)}</ul>
          </section>
          <section>
            <h2>Stack</h2>
            <div class="chips">{p.stack.map((t) => <span class="chip">{t}</span>)}</div>
            <h2 class="mt">Year</h2>
            <span class="chip">{p.year}</span>
          </section>
        </div>
      </div>
    </article>

    <a class="next" href={`/work/${next.slug}`}>
      <span class="next-label">next project</span>
      <span class="next-name">{next.name} →</span>
    </a>
  </main>
</Base>

<style>
  .page {
    flex: 1;
    width: 100%;
    max-width: 940px;
    margin-inline: auto;
    padding: 30px 24px 70px;
  }
  .back {
    display: inline-block;
    margin-bottom: 20px;
    font-size: 15px;
    color: #9a9a9a;
    text-decoration: none;
  }
  .back:hover { color: #141414; }

  .window {
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.11), 0 2px 8px rgba(0, 0, 0, 0.05);
    overflow: hidden;
  }
  .titlebar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 16px;
    background: #f1f1f1;
    border-bottom: 1px solid #e4e4e4;
  }
  .dot { width: 12px; height: 12px; border-radius: 50%; flex: none; }
  .dot.r { background: #ff5f57; } .dot.y { background: #febc2e; } .dot.g { background: #28c840; }
  .path {
    flex: 1;
    text-align: center;
    margin-right: 52px;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 12.5px;
    color: #7a7a7a;
  }

  .body { padding: 34px 40px 42px; }

  .head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
  }
  h1 {
    margin: 0;
    font-size: clamp(1.9rem, 4vw, 2.3rem);
    letter-spacing: -0.03em;
  }
  .tagline {
    margin: 7px 0 0;
    font-size: 17px;
    color: #6d6d6d;
    line-height: 1.45;
  }
  .status {
    flex: none;
    font-size: 12.5px;
    padding: 6px 12px;
    border-radius: 999px;
    background: #f2f2f2;
    color: #5a5a5a;
    white-space: nowrap;
  }
  .status--shipped { background: #e7f7ec; color: #1c7a3e; }
  .status--prototype { background: #fdf1dd; color: #8a5a12; }
  .status--source-only { background: #e9f1fd; color: #24558f; }

  .summary {
    margin: 22px 0 0;
    font-size: 16px;
    line-height: 1.65;
    color: #3d3d3d;
    max-width: 68ch;
  }

  .actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 24px; }
  .btn {
    display: inline-flex;
    align-items: center;
    padding: 9px 16px;
    border: 1px solid #dcdcdc;
    border-radius: 8px;
    background: #fff;
    color: #141414;
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    transition: background 0.18s ease, border-color 0.18s ease;
  }
  .btn:hover { background: #f5f5f5; }
  .btn--primary { background: #141414; color: #fff; border-color: #141414; }
  .btn--primary:hover { background: #2c2c2c; }

  .shots {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    margin-top: 32px;
  }
  .shot {
    width: 100%;
    border-radius: 10px;
    border: 1px solid #e6e6e6;
    display: block;
  }
  .shot--lead { grid-column: 1 / -1; }

  .meta {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 36px;
    margin-top: 36px;
    padding-top: 30px;
    border-top: 1px solid #eee;
  }
  h2 {
    margin: 0 0 12px;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: #9a9a9a;
  }
  h2.mt { margin-top: 26px; }
  ul { margin: 0; padding-left: 18px; }
  li { color: #3d3d3d; font-size: 15px; line-height: 1.7; margin-bottom: 4px; }
  .chips { display: flex; flex-wrap: wrap; gap: 7px; }
  .chip {
    font-size: 13px;
    padding: 5px 11px;
    border-radius: 999px;
    background: #f2f2f2;
    color: #4a4a4a;
  }

  .next {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 2px;
    margin-top: 26px;
    text-decoration: none;
  }
  .next-label { font-size: 12px; text-transform: uppercase; letter-spacing: 0.09em; color: #b4b4b4; }
  .next-name { font-size: 18px; font-weight: 600; color: #141414; letter-spacing: -0.02em; }
  .next:hover .next-name { color: #6fbbff; }

  @media (max-width: 720px) {
    .page { padding: 22px 16px 50px; }
    .body { padding: 26px 22px 30px; }
    .head { flex-direction: column; gap: 12px; }
    .meta { grid-template-columns: 1fr; gap: 26px; }
    .shots { grid-template-columns: 1fr; }
    .shot--lead { grid-column: auto; }
  }
</style>
