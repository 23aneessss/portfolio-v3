            <tr><th scope="row">Born</th><td>Algiers, Algeria</td></tr>
            <tr><th scope="row">Nationality</th><td>Algerian</td></tr>
            <tr><th scope="row">Occupation</th><td>Student</td></tr>
            <tr><th scope="row">Years&nbsp;active</th><td>2023–present</td></tr>
            <tr><th scope="row">Alma&nbsp;mater</th><td><a href="https://esi.dz" target="_blank" rel="noopener">ESI Algiers</a></td></tr>
            <tr><th scope="row">Member of</th><td>ETIC Club</td></tr>
            <tr><th scope="row">Status</th><td><span class="open">open to opportunities</span></td></tr>
            <tr>
