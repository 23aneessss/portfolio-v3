<script>
  // tiny, non-intrusive easter eggs — this is a readable page, not a toy.
  // [edit] links: pretend the visitor tried to edit Wikipedia.
  for (const el of document.querySelectorAll<HTMLElement>('.edit')) {
    el.style.cursor = 'pointer';
    el.addEventListener('click', () => {
      if (confirm("You don't have permission to edit Aness.\n\nWikipedia is read-only for visitors — but he's open to feedback. Open the contact page?")) {
        window.location.href = '/contact';
      }
    });
  }

  // [citation needed] / [clarification needed]: hover/focus popover.
  let activeTip: HTMLElement | null = null;
  const showTip = (cn: HTMLElement) => {
    hideTip();
    const note = cn.dataset.note;
    if (!note) return;
    const tip = document.createElement('div');
    tip.className = 'cn-tip';
    tip.textContent = note;
    document.body.appendChild(tip);
    const r = cn.getBoundingClientRect();
    const tw = tip.offsetWidth;
    tip.style.left = `${Math.max(8, r.left + r.width / 2 - tw / 2)}px`;
    tip.style.top = `${window.scrollY + r.bottom + 6}px`;
    activeTip = tip;
  };
  const hideTip = () => {
    if (activeTip) {
      activeTip.remove();
      activeTip = null;
    }
  };
  for (const cn of document.querySelectorAll<HTMLElement>('.cn')) {
    cn.tabIndex = 0;
    cn.addEventListener('pointerenter', () => showTip(cn));
    cn.addEventListener('pointerleave', hideTip);
    cn.addEventListener('focus', () => showTip(cn));
    cn.addEventListener('blur', hideTip);
  }
</script>

