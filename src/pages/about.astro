        <li><a href="https://wa.me/213782594339" target="_blank" rel="noopener">WhatsApp — +213 782 594 339</a></li>
        <li><a href="mailto:oa_bouziani@esi.dz">Email — oa_bouziani@esi.dz</a> · <a href="/contact">Contact page</a></li>
      </ul>

