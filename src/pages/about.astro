---
import Base from '../layouts/Base.astro';

// journey data pulled from the old portfolio
const JOURNEY = [
  {
    when: '2023',
    tag: 'EDUCATION',
    title: 'First Baccalaureate',
    body: 'The beginning of the higher-education journey — first key to engineering school.',
  },
  {
    when: '2023 – 2024',
    tag: 'EDUCATION',
    title: 'Autonomous Systems Studies',
    body: 'National Higher School of Autonomous Systems.',
  },
  {
    when: '2024',
    tag: 'ACHIEVEMENT',
    title: 'Second Baccalaureate',
    body: 'Yes — a second one. Achievement unlocked ×2 🏆',
  },
  {
    when: '2024 – now',
    tag: 'EDUCATION',
    title: 'Computer Science @ ESI Algiers',
    body: 'National Higher School of Computer Science — 2CP, crafting systems & useful products.',
  },
  {
    when: '2024 – now',
    tag: 'CLUB',
    title: 'Active Member — ETIC Club',
    body: 'Building, organizing and shipping with the club.',
  },
  {
    when: '2026',
    tag: 'EVENT',
    title: 'Event Coordinator — S2EE 17',
    body: 'Coordinating one of ETIC Club’s flagship events.',
  },
];

const STORAGE = [
  { label: 'Code', pct: 38, color: '#6fbbff', note: 'TypeScript, Swift, Dart & friends' },
  { label: 'Ideas', pct: 22, color: '#b59dfb', note: 'side-project queue, always growing' },
  { label: 'Coffee', pct: 18, color: '#ffb866', note: 'system fuel — do not delete' },
  { label: 'Projects', pct: 14, color: '#7ee787', note: '16 shipped and counting' },
  { label: 'Sleep', pct: 4, color: '#ff7b72', note: 'partition nearly empty (by design)' },
  { label: 'Free', pct: 4, color: '#d9d9de', note: 'reserved for your project 😉' },
];
---

<Base title="About — Aness Bouziani" description="About Aness Bouziani — full-stack & mobile developer, CS student at ESI Algiers.">
  <header class="header">
    <a class="back" href="/">←</a>
    <div>
      <h1 class="title">About</h1>
      <p class="hint">Every machine has a spec sheet. Here's mine.</p>
    </div>
  </header>

  <main class="stage">
    <div class="mac-window" id="mac-window">
      <div class="titlebar">
        <span class="lights">
          <button class="light l-red" id="tl-red" title="close (back home)" aria-label="Close — back to home"></button>
          <button class="light l-yellow" id="tl-yellow" title="minimize" aria-label="Minimize"></button>
          <button class="light l-green" id="tl-green" title="zoom" aria-label="Zoom window"></button>
        </span>
        <span class="win-title">About This Aness</span>
      </div>

      <nav class="tabs" id="tabs">
        <button class="tab active" data-panel="overview">Overview</button>
        <button class="tab" data-panel="storage">Storage</button>
        <button class="tab" data-panel="journey">Journey</button>
      </nav>

      <!-- ─── Overview ─── -->
      <section class="panel active" id="panel-overview">
        <div class="overview">
          <div class="hero">
            <img class="portrait" src="/avatar.webp" alt="Aness Bouziani" />
            <span class="os-badge">anessOS</span>
          </div>
          <div class="specs">
            <h2 class="dev-name">Aness Bouziani</h2>
            <p class="dev-role">Full-Stack &amp; Mobile Developer, 2CP</p>

            <dl class="spec-list">
              <div><dt>Chip</dt><dd>Aness B1 Pro — neural engine permanently overclocked</dd></div>
              <div><dt>Memory</dt><dd>Unlimited curiosity (expandable with coffee)</dd></div>
              <div><dt>Startup Disk</dt><dd>Coffee HD ☕</dd></div>
              <div><dt>OS</dt><dd>anessOS 2CP — ESI Algiers build</dd></div>
              <div><dt>Location</dt><dd>Algiers, Algeria 🇩🇿 — remote-friendly</dd></div>
              <div><dt>Serial</dt><dd class="mono">DZ-ESI-23ANEESSSS</dd></div>
              <div><dt>Uptime</dt><dd class="mono" id="uptime">…</dd></div>
            </dl>

            <div class="btn-row">
              <button class="mac-btn" id="btn-info">More Info…</button>
              <button class="mac-btn" id="btn-update">Software Update…</button>
            </div>
            <div class="update-zone" id="update-zone" hidden>
              <div class="update-bar"><i id="update-fill"></i></div>
              <p class="update-msg" id="update-msg">Checking for updates…</p>
            </div>
          </div>
        </div>
        <p class="footnote">Crafting systems &amp; useful products — made of pixels and caffeine. Status: <strong>open to opportunities</strong>.</p>
      </section>

      <!-- ─── Storage ─── -->
      <section class="panel" id="panel-storage">
        <h3 class="panel-title">Aness HD — 512 GB of human</h3>
        <div class="storage-bar">
          {STORAGE.map((s) => (
            <span
              class="seg"
              style={`--w:${s.pct}%; --c:${s.color}`}
              data-label={`${s.label} — ${s.note}`}
            ></span>
          ))}
        </div>
        <p class="storage-tip" id="storage-tip">hover a segment 👆</p>
        <ul class="legend">
          {STORAGE.map((s) => (
            <li>
              <i style={`--c:${s.color}`}></i>
              <strong>{s.label}</strong>
              <span>{s.pct}%</span>
              <em>{s.note}</em>
            </li>
          ))}
        </ul>
        <div class="battery-box">
          <span class="battery"><i></i></span>
          <div>
            <strong>Motivation — 100%</strong>
            <p>Power source: coffee &amp; shipping features. Battery health: excellent, no degradation since 2023.</p>
          </div>
        </div>
      </section>

      <!-- ─── Journey ─── -->
      <section class="panel" id="panel-journey">
        <h3 class="panel-title">system.log — the path so far</h3>
        <ol class="timeline">
          {JOURNEY.map((j) => (
            <li>
              <span class="tl-dot"></span>
              <span class="tl-when mono">{j.when}</span>
              <span class={`tl-tag tag-${j.tag.toLowerCase()}`}>{j.tag}</span>
              <h4>{j.title}</h4>
              <p>{j.body}</p>
            </li>
          ))}
        </ol>
      </section>

      <div class="win-toast" id="win-toast"></div>
    </div>
  </main>

  <p class="credits">
    3D models: Folder by reyshapes (CC0) · Coffee cup by Poly by Google (CC-BY), via
    <a href="https://poly.pizza" target="_blank" rel="noopener">Poly Pizza</a> · iPhone 15 Pro Max by
    <a href="https://sketchfab.com/MG990" target="_blank" rel="noopener">MpPower™</a> (CC-BY) · MacBook Pro M3 by
    <a href="https://sketchfab.com/jackbaeten" target="_blank" rel="noopener">jackbaeten</a> (CC-BY), via Sketchfab.
  </p>
</Base>

<script>
  const win = document.getElementById('mac-window')!;
  const tabs = document.getElementById('tabs')!;
  const toastEl = document.getElementById('win-toast')!;

  // ---------- tabs ----------
  const show = (name: string) => {
    for (const t of tabs.querySelectorAll('.tab')) t.classList.toggle('active', (t as HTMLElement).dataset.panel === name);
    for (const p of win.querySelectorAll('.panel')) p.classList.toggle('active', p.id === `panel-${name}`);
  };
  tabs.addEventListener('click', (e) => {
    const t = (e.target as HTMLElement).closest<HTMLElement>('.tab');
    if (t) show(t.dataset.panel!);
  });
  document.getElementById('btn-info')!.addEventListener('click', () => show('journey'));

  // ---------- toast ----------
  let toastTimer = 0;
  const toast = (msg: string) => {
    toastEl.textContent = msg;
    toastEl.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => toastEl.classList.remove('show'), 2600);
  };

  // ---------- live uptime (booted at ESI, Sep 2024) ----------
  const uptimeEl = document.getElementById('uptime')!;
  const BOOT = new Date('2024-09-15T08:00:00');
  const tick = () => {
    let s = Math.max(0, Math.floor((Date.now() - BOOT.getTime()) / 1000));
    const d = Math.floor(s / 86400);
    s -= d * 86400;
    const h = Math.floor(s / 3600);
    const m = Math.floor((s % 3600) / 60);
    uptimeEl.textContent = `${d} days, ${h}h ${m}m ${s % 60}s — no reboot needed`;
  };
  tick();
  setInterval(tick, 1000);

  // ---------- Software Update gag ----------
  const btnUpdate = document.getElementById('btn-update')! as HTMLButtonElement;
  const zone = document.getElementById('update-zone')!;
  const fill = document.getElementById('update-fill')!;
  const msg = document.getElementById('update-msg')!;
  let updating = false;
  btnUpdate.addEventListener('click', () => {
    if (updating) return;
    updating = true;
    zone.hidden = false;
    fill.style.transition = 'none';
    fill.style.width = '0%';
    msg.textContent = 'Checking for updates…';
    requestAnimationFrame(() => {
      fill.style.transition = 'width 2.2s cubic-bezier(0.3, 0.8, 0.4, 1)';
      fill.style.width = '100%';
    });
    setTimeout(() => (msg.textContent = 'Downloading new skills…'), 900);
    setTimeout(() => {
      msg.textContent = '✓ Aness is up to date — version 2CP (learning daily, updates ship continuously).';
      updating = false;
    }, 2400);
  });

  // ---------- traffic lights ----------
  document.getElementById('tl-red')!.addEventListener('click', () => {
    win.classList.add('closing');
    setTimeout(() => (window.location.href = '/'), 240);
  });
  document.getElementById('tl-yellow')!.addEventListener('click', () => {
    win.classList.add('minimized');
    setTimeout(() => {
      win.classList.remove('minimized');
      toast('nice try — there is no dock here 😄');
    }, 900);
  });
  document.getElementById('tl-green')!.addEventListener('click', () => {
    win.classList.toggle('zoomed');
  });

  // ---------- storage segments tooltip ----------
  const tip = document.getElementById('storage-tip')!;
  const defaultTip = tip.textContent!;
  for (const seg of document.querySelectorAll<HTMLElement>('.seg')) {
    seg.addEventListener('pointerenter', () => (tip.textContent = seg.dataset.label!));
    seg.addEventListener('pointerleave', () => (tip.textContent = defaultTip));
  }
</script>

<style>
  .header {
    display: flex;
    align-items: baseline;
    gap: 20px;
    padding: 34px 44px 0;
  }
  .back {
    font-size: 26px;
    font-weight: 700;
    color: #141414;
    text-decoration: none;
    line-height: 1;
  }
  .back:hover {
    color: #6fbbff;
  }
  .title {
    margin: 0;
    font-size: clamp(1.8rem, 3.4vw, 2.6rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }
  .hint {
    margin: 6px 0 0;
    font-size: 15px;
    color: #767676;
  }
  .mono {
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 0.92em;
  }

  .stage {
    flex: 1;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 30px 16px 24px;
  }

  /* ---------- the window ---------- */
  .mac-window {
    position: relative;
    width: min(680px, 100%);
    background: #f6f6f8;
    border: 1px solid #dcdce0;
    border-radius: 12px;
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.14), 0 2px 10px rgba(0, 0, 0, 0.06);
    overflow: hidden;
    transition: transform 0.24s ease, opacity 0.24s ease, width 0.3s ease;
    animation: win-open 0.32s cubic-bezier(0.2, 0.9, 0.3, 1.1) both;
  }
  @keyframes win-open {
    from {
      opacity: 0;
      transform: scale(0.92) translateY(14px);
    }
  }
  .mac-window.zoomed {
    width: min(940px, 100%);
  }
  .mac-window.closing {
    transform: scale(0.9);
    opacity: 0;
  }
  .mac-window.minimized {
    transform: scale(0.06) translateY(160%) rotate(2deg);
    opacity: 0;
  }

  .titlebar {
    position: relative;
    display: flex;
    align-items: center;
    height: 40px;
    padding: 0 14px;
    background: linear-gradient(#ececef, #e2e2e6);
    border-bottom: 1px solid #d3d3d8;
  }
  .lights {
    display: flex;
    gap: 8px;
  }
  .light {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: none;
    padding: 0;
    cursor: pointer;
  }
  .l-red { background: #ff5f57; }
  .l-yellow { background: #febc2e; }
  .l-green { background: #28c840; }
  .light:hover { filter: brightness(0.85); }
  .win-title {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    font-size: 13px;
    font-weight: 600;
    color: #6d6d73;
  }

  /* ---------- tabs ---------- */
  .tabs {
    display: flex;
    justify-content: center;
    gap: 4px;
    padding: 12px 0 0;
  }
  .tab {
    border: none;
    background: none;
    padding: 6px 16px;
    border-radius: 8px;
    font-size: 13.5px;
    font-weight: 600;
    color: #6d6d73;
    cursor: pointer;
  }
  .tab:hover { background: #e8e8ec; }
  .tab.active {
    background: #fff;
    color: #141414;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.1);
  }

  .panel {
    display: none;
    padding: 26px 34px 30px;
  }
  .panel.active { display: block; }
  .panel-title {
    margin: 0 0 18px;
    font-size: 15px;
    font-weight: 700;
    color: #141414;
    letter-spacing: -0.01em;
  }

  /* ---------- overview ---------- */
  .overview {
    display: flex;
    gap: 30px;
    align-items: flex-start;
  }
  .hero {
    position: relative;
    flex: 0 0 auto;
  }
  .portrait {
    width: 150px;
    height: 150px;
    object-fit: cover;
    object-position: top;
    border-radius: 50%;
    background: linear-gradient(160deg, #a8c6ff, #ffd3e6);
    box-shadow: 0 8px 22px rgba(80, 100, 160, 0.22);
  }
  .os-badge {
    position: absolute;
    bottom: 2px;
    left: 50%;
    transform: translateX(-50%);
    background: #141414;
    color: #fff;
    font-size: 10.5px;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: 999px;
    letter-spacing: 0.02em;
  }
  .dev-name {
    margin: 4px 0 2px;
    font-size: 26px;
    font-weight: 750;
    letter-spacing: -0.03em;
  }
  .dev-role {
    margin: 0 0 16px;
    font-size: 14px;
    color: #8a8a90;
  }
  .spec-list {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 7px;
  }
  .spec-list div {
    display: flex;
    gap: 10px;
    font-size: 13.5px;
    line-height: 1.5;
  }
  .spec-list dt {
    flex: 0 0 96px;
    font-weight: 650;
    color: #141414;
    text-align: right;
  }
  .spec-list dd {
    margin: 0;
    color: #55555c;
  }
  .btn-row {
    display: flex;
    gap: 10px;
    margin-top: 20px;
  }
  .mac-btn {
    font-size: 13px;
    font-weight: 600;
    padding: 6px 14px;
    border-radius: 7px;
    border: 1px solid #d0d0d6;
    background: linear-gradient(#fff, #f3f3f6);
    color: #141414;
    cursor: pointer;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.06);
  }
  .mac-btn:hover { background: #fff; }
  .mac-btn:active {
    background: #e8e8ec;
    box-shadow: none;
  }
  .update-zone {
    margin-top: 16px;
    max-width: 380px;
  }
  .update-bar {
    height: 6px;
    border-radius: 999px;
    background: #e2e2e7;
    overflow: hidden;
  }
  .update-bar i {
    display: block;
    height: 100%;
    width: 0%;
    border-radius: 999px;
    background: #6fbbff;
  }
  .update-msg {
    margin: 8px 0 0;
    font-size: 12.5px;
    color: #6d6d73;
  }
  .footnote {
    margin: 24px 0 0;
    padding-top: 16px;
    border-top: 1px solid #e4e4e8;
    font-size: 13px;
    color: #6d6d73;
  }
  .footnote strong { color: #1f9d4d; }

  /* ---------- storage ---------- */
  .storage-bar {
    display: flex;
    height: 34px;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid #d6d6db;
  }
  .seg {
    width: var(--w);
    background: linear-gradient(180deg, color-mix(in srgb, var(--c) 82%, #fff), var(--c));
    cursor: pointer;
    transition: filter 0.15s ease;
  }
  .seg:hover { filter: brightness(1.08) saturate(1.15); }
  .storage-tip {
    margin: 10px 2px 18px;
    font-size: 12.5px;
    color: #8a8a90;
    min-height: 1.2em;
  }
  .legend {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 9px 26px;
  }
  .legend li {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-size: 13px;
  }
  .legend i {
    flex: 0 0 auto;
    width: 10px;
    height: 10px;
    border-radius: 3px;
    background: var(--c);
    align-self: center;
  }
  .legend strong { color: #141414; }
  .legend span { color: #8a8a90; }
  .legend em {
    color: #8a8a90;
    font-style: normal;
    font-size: 12px;
  }
  .battery-box {
    display: flex;
    gap: 16px;
    align-items: center;
    margin-top: 24px;
    padding: 14px 16px;
    background: #fff;
    border: 1px solid #e4e4e8;
    border-radius: 12px;
  }
  .battery {
    flex: 0 0 auto;
    position: relative;
    width: 46px;
    height: 22px;
    border: 2px solid #b9b9c0;
    border-radius: 6px;
    padding: 2.5px;
  }
  .battery::after {
    content: '';
    position: absolute;
    right: -6px;
    top: 50%;
    transform: translateY(-50%);
    width: 3px;
    height: 9px;
    background: #b9b9c0;
    border-radius: 0 2px 2px 0;
  }
  .battery i {
    display: block;
    height: 100%;
    width: 100%;
    background: #28c840;
    border-radius: 2.5px;
  }
  .battery-box strong { font-size: 13.5px; }
  .battery-box p {
    margin: 3px 0 0;
    font-size: 12.5px;
    color: #6d6d73;
    line-height: 1.5;
  }

  /* ---------- journey ---------- */
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0 0 0 22px;
    position: relative;
  }
  .timeline::before {
    content: '';
    position: absolute;
    left: 5px;
    top: 6px;
    bottom: 6px;
    width: 2px;
    background: #e0e0e5;
    border-radius: 2px;
  }
  .timeline li {
    position: relative;
    padding: 0 0 22px;
  }
  .timeline li:last-child { padding-bottom: 4px; }
  .tl-dot {
    position: absolute;
    left: -22px;
    top: 5px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #6fbbff;
    border: 2.5px solid #f6f6f8;
    box-shadow: 0 0 0 2px rgba(111, 187, 255, 0.25);
  }
  .tl-when {
    font-size: 12px;
    color: #8a8a90;
    margin-right: 8px;
  }
  .tl-tag {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.06em;
    padding: 2px 8px;
    border-radius: 999px;
    background: #eaeaef;
    color: #55555c;
  }
  .tag-achievement { background: #fff3d6; color: #a06b00; }
  .tag-club { background: #e8f7ec; color: #1f9d4d; }
  .tag-event { background: #f0e9ff; color: #7a4fd0; }
  .timeline h4 {
    margin: 7px 0 3px;
    font-size: 15px;
    letter-spacing: -0.01em;
  }
  .timeline p {
    margin: 0;
    font-size: 13px;
    color: #6d6d73;
    line-height: 1.55;
  }

  /* ---------- toast ---------- */
  .win-toast {
    position: absolute;
    bottom: 14px;
    left: 50%;
    transform: translate(-50%, 8px);
    padding: 8px 18px;
    border-radius: 999px;
    background: rgba(22, 24, 29, 0.92);
    color: #fff;
    font-size: 12.5px;
    font-weight: 550;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
    white-space: nowrap;
  }
  .win-toast.show {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  .credits {
    margin: 0 auto;
    padding: 0 24px 26px;
    max-width: 680px;
    font-size: 12px;
    color: #b0b0b0;
    text-align: center;
  }
  .credits a {
    color: #909090;
  }

  @media (prefers-reduced-motion: reduce) {
    .mac-window { animation: none; }
  }

  @media (max-width: 760px) {
    .header {
      padding: 22px 24px 0;
    }
    .stage {
      padding: 20px 12px 24px;
    }
    .overview {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
    .spec-list div {
      flex-direction: column;
      gap: 0;
    }
    .spec-list dt {
      flex: none;
      text-align: center;
    }
    .btn-row { justify-content: center; }
    .panel { padding: 20px 18px 24px; }
    .legend { grid-template-columns: 1fr; }
    .win-toast { white-space: normal; width: max-content; max-width: 90%; text-align: center; }
  }
</style>
